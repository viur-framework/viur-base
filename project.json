{
    "cli-version": "3.0.2",
    "default": {
        "application_name": "{{app_id}}",
        "builds": {
            "admin": {
                "command": "viur admin install 4.14.7",
                "kind": "exec",
                "version": "4.14.7"
            },
            "app": {
                "command": "build:app",
                "kind": "npm",
                "source": ""
            },
            "site": {
                "command": "build:site",
                "kind": "npm",
                "source": ""
            }
        },
        "distribution_folder": "./deploy",
        "sources_folder": "./sources",
        "version": "$(year)-$(month)-$(day)-$(user)-dev"
    },
    "format": "2.0.0",
    "live": {
        "version": "$(year)-$(month)-$(day)-$(user)"
    }
}
