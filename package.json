{
  "name": "project-root",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w=sources/site",
    "build": "npm run icons && npm run lock && npm ci --prefix=sources/site && npm run build --prefix=sources/site",
    "lock": "npm i --prefix=sources/site --package-lock-only",
    "update:utils": "npm update @viur/vue-utils -ws -S --package-lock-only",
    "update:components": "npm update @viur/vue-components -ws -S --package-lock-only",
    "update": "npm run update:utils && npm run update:components",
    "icons": "npx wa-icons . ./sources/site/public/assets/icons"
  },
  "author": "Andreas H. Kelch",
  "workspaces": [
    "sources/site"
  ],
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.53.3",
    "@rollup/rollup-darwin-arm64":"^4.53.3"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1"
  }
}
